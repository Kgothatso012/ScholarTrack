{
  "expo": {
    "name": "ScholarTrack",
    "slug": "scholartrack-expo54",
    "version": "1.0.0",
    "scheme": "scholartrack",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "extra": {
      "eas": {
        "projectId": "3b702f34-db44-4b73-9ff5-2fde0fd52d2f"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scholartrack.sa"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "com.scholartrack.sa",
      "config": {
        "googleMaps": {
          "apiKey": "${EXPO_PUBLIC_GOOGLE_MAPS_API_KEY}"
        }
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
